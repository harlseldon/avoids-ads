# Plantilla. Copiar a .env y rellenar. El .env real no se sube a git.
TZ=America/Mexico_City

# Contraseña del panel de Pi-hole (generada aleatoriamente).
PIHOLE_PASSWORD=cambiame-por-una-contrasena-larga

# IPs del host donde se publican los puertos.
LAN_IP=192.168.100.7
TS_IP=100.90.4.57
ADMIN_PORT=8081

# Red local, para el conditional forwarding.
LAN_SUBNET=192.168.100.0/24
ROUTER_IP=192.168.100.1


# Red interna del stack (IPs fijas: dnsmasq necesita IP, no nombre, como upstream).
DNS_SUBNET=172.30.0.0/24
DOH_IP=172.30.0.2
PIHOLE_IP=172.30.0.3
